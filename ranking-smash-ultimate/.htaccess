DirectoryIndex index.html
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <Files "public.json">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>

# La encuesta y su panel viven en rankingsmashbros.com desde el 7 de octubre de 2026 y guardan en
# su base de datos. Las páginas de este dominio escribían en un archivo que ya nadie lee.
<IfModule mod_alias.c>
  RedirectMatch 302 ^/ranking-smash-ultimate/encuesta\.php$ https://rankingsmashbros.com/encuesta.php
  RedirectMatch 302 ^/ranking-smash-ultimate/opiniones\.php$ https://rankingsmashbros.com/opiniones.php
</IfModule>
